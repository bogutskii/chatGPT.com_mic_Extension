{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "2.3",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Petr Bogutskii",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "type": "module"
    }
  ],
  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "img/*",
        "styles.css",
        "languages.js",
        "ui.js",
        "state.js",
        "speech.js",
        "modal.js",
        "micPosition.js",
        "autoGeneration.js",
        "widthAdjustment.js",
        "clearButton.js",
        "i18n.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
